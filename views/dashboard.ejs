<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Dashboard | RentEase</title>
</head>
<body class="min-h-screen bg-zinc-950 text-white">

    <div class="mx-auto min-h-screen max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

        <nav class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 px-5 py-4">
            <a href="/dashboard" class="text-2xl font-bold tracking-tight">
                Rent<span class="text-blue-400">Ease</span>
            </a>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-zinc-300">
                <a href="/dashboard" class="font-medium text-blue-400">Dashboard</a>
                <a href="/profile" class="transition hover:text-blue-400">Profile</a>
                <a href="/login" class="transition hover:text-blue-400">Login</a>
                <a href="/signup" class="rounded-lg border border-zinc-700 px-3 py-2 transition hover:border-blue-500 hover:text-blue-400">Signup</a>
            </div>
        </nav>

        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="mb-2 text-sm font-medium text-blue-400">FIND WHAT YOU NEED</p>
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Dashboard</h1>
                <p class="mt-2 text-zinc-400">Explore equipment available for rent.</p>
            </div>

            <a href="/equipment" class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-semibold transition hover:bg-blue-400">
                + List Equipment
            </a>
        </div>

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-xl font-semibold">Available Equipment</h2>
            <span class="text-sm text-zinc-500"><%= equipments.length %> items</span>
        </div>

        <% if (equipments.length === 0) { %>
            <div class="rounded-2xl border border-dashed border-zinc-700 bg-zinc-900 p-10 text-center">
                <h3 class="text-lg font-semibold">No equipment available</h3>
                <p class="mt-2 text-sm text-zinc-400">Be the first to list equipment for rent.</p>
                <a href="/equipment" class="mt-5 inline-block rounded-lg bg-blue-500 px-4 py-2 text-sm font-semibold transition hover:bg-blue-400">
                    List Your Equipment
                </a>
            </div>
        <% } else { %>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

                <% equipments.forEach((item) => { %>
                    <div class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-900 p-5 transition hover:border-zinc-700">

                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10 text-xl text-blue-400">
                            ◈
                        </div>

                        <h3 class="mb-2 break-words text-xl font-semibold">
                            <%= item.name %>
                        </h3>

                        <p class="mb-6 flex-1 whitespace-pre-line break-words text-sm leading-6 text-zinc-400">
                            <%= item.description %>
                        </p>

                        <div class="flex items-center justify-between gap-3 border-t border-zinc-800 pt-4">
                            <div>
                                <p class="text-xs text-zinc-500">Rental price</p>
                                <p class="mt-1 text-lg font-semibold text-emerald-400">
                                    ₹<%= item.ppd %><span class="text-sm font-normal text-zinc-400"> / day</span>
                                </p>
                            </div>

                            <a href="/rent/<%= item._id %>" class="rounded-lg bg-blue-500 px-4 py-2 text-sm font-semibold transition hover:bg-blue-400">
                                Rent
                            </a>
                        </div>

                    </div>
                <% }) %>

            </div>

        <% } %>

    </div>

</body>
</html>
