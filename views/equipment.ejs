<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List Equipment | RentEase</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-zinc-950 text-white">

    <nav class="border-b border-zinc-800 bg-zinc-950">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
            <a href="/dashboard" class="text-2xl font-bold tracking-tight">
                Rent<span class="text-blue-500">Ease</span>
            </a>
            <div class="flex items-center gap-6 text-sm text-zinc-400">
                <a href="/dashboard" class="transition hover:text-white">Dashboard</a>
                <a href="/profile" class="transition hover:text-white">Profile</a>
            </div>
        </div>
    </nav>

    <main class="mx-auto flex max-w-7xl justify-center px-6 py-12">
        <section class="w-full max-w-xl rounded-2xl border border-zinc-800 bg-zinc-900 p-8 sm:p-10">
            <p class="mb-2 text-sm font-medium text-blue-400">START EARNING</p>
            <h1 class="text-3xl font-bold">List Your Equipment</h1>
            <p class="mt-3 text-sm leading-6 text-zinc-400">
                Add your equipment and make it available for others to rent.
            </p>

            <form action="/equipment" method="POST" class="mt-8 space-y-6">
                <div>
                    <label for="name" class="mb-2 block text-sm font-medium text-zinc-300">Equipment Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        placeholder="e.g. Camera, Drill Machine"
                        class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-white outline-none transition placeholder:text-zinc-600 focus:border-blue-500"
                    >
                </div>

                <div>
                    <label for="description" class="mb-2 block text-sm font-medium text-zinc-300">Description</label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        required
                        placeholder="Describe your equipment..."
                        class="w-full resize-y rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-white outline-none transition placeholder:text-zinc-600 focus:border-blue-500"
                    ></textarea>
                </div>

                <div>
                    <label for="ppd" class="mb-2 block text-sm font-medium text-zinc-300">Price Per Day (₹)</label>
                    <input
                        type="number"
                        id="ppd"
                        name="ppd"
                        min="1"
                        required
                        placeholder="Enter daily rental price"
                        class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-white outline-none transition placeholder:text-zinc-600 focus:border-blue-500"
                    >
                </div>

                <button
                    type="submit"
                    class="w-full rounded-xl bg-blue-600 px-5 py-3 font-semibold transition hover:bg-blue-500"
                >
                    Publish Equipment
                </button>
            </form>

            <a href="/dashboard" class="mt-6 block text-center text-sm text-zinc-400 transition hover:text-white">
                Back to Dashboard
            </a>
        </section>
    </main>

</body>
</html>